# =============================================================================
# Madex IT Solutions – Umgebungsvariablen
# Kopieren Sie diese Datei nach .env (lokal) bzw. tragen Sie die Werte in Coolify
# unter "Environment Variables" ein. Werte ohne NEXT_PUBLIC_ bleiben auf dem Server.
#
# Alles, was hier steht, ist im Dashboard NICHT mehr einstellbar – das Dashboard
# zeigt diese Werte nur an. Nach einer Änderung die App neu starten.
# Was fehlt, zeigt ohne Anmeldung: https://madex-it.ch/admin/status
# =============================================================================

# --- Website (Pflicht) ------------------------------------------------------------
# Öffentliche Adresse: Canonicals, Sitemap, Open Graph, Links in E-Mails
NEXT_PUBLIC_SITE_URL=https://madex-it.ch
# Adresse des Dashboards (Links in E-Mails, z. B. Wochenbericht). Meist dieselbe wie oben.
APP_URL=https://madex-it.ch

# --- Daten (Pflicht) ----------------------------------------------------------------
# Ordner für ALLE Daten: eingebaute Datenbank (pglite/), Uploads, Analysen, Projekte,
# Chat-Verläufe, Schlüssel (.app-secret). Muss Neuinstallationen überstehen
# (Coolify: persistentes Volume, z. B. /app/data).
DATA_DIR=./.data
# Verschlüsselung der Chat-Ablage (AES-256). Einmal erzeugen und NIE ändern:
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Optional, mind. 32 Zeichen. Leer = wird erzeugt und in DATA_DIR/.app-secret gespeichert.
APP_SECRET=

# Datenbank: LEER LASSEN = eingebaute Datenbank in DATA_DIR/pglite (kein Datenbank-Server
# nötig, die App darf dann nur einmal laufen). Nur für einen externen PostgreSQL-Server
# ausfüllen (Coolify-Datenbank, Neon, Supabase), z. B. postgres://user:pass@host:5432/db
DATABASE_URL=

# --- Geplante Aufgaben (Pflicht) ----------------------------------------------------
# Schützt /api/cron (mind. 16 Zeichen: openssl rand -hex 24). In Coolify eine geplante
# Aufgabe alle 15 Minuten anlegen:
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://madex-it.ch/api/cron
# Sie erinnert an fällige Nachfass-Termine, verschickt montags ab 07:00 den Wochenbericht
# und räumt abgelaufene Sitzungen auf.
CRON_SECRET=

# --- Erster Admin-Zugang (/admin) ----------------------------------------------------
# Inhaber-Konto bei leerer Datenbank automatisch anlegen (sonst Ersteinrichtung unter /admin).
# Anmeldung mit der E-Mail-Adresse; beim ersten Login wird die Zwei-Faktor-Anmeldung
# eingerichtet. Passwort mind. 12 Zeichen.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Notfall: auf true setzen und App neu starten = Konto ADMIN_EMAIL bekommt ADMIN_PASSWORD,
# Sperre und 2FA werden zurückgesetzt. Danach WIEDER ENTFERNEN.
ADMIN_RESET=

# --- E-Mail-Versand (SMTP) ------------------------------------------------------------
# Für Anfragen, Analyse-Berichte, Erinnerungen und den Wochenbericht.
# Ohne SMTP_HOST werden E-Mails nur protokolliert (Sicherheit → E-Mail-Protokoll).
SMTP_HOST=
# 587 mit STARTTLS (SMTP_SECURE=false) oder 465 mit SSL (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Absender – muss vom SMTP-Server erlaubt sein. Format: Name <adresse>
MAIL_FROM=Madex IT Solutions <website@madex-it.ch>
# Nur der Server steht hier – WER welche E-Mails bekommt, wird im Dashboard unter
# Einstellungen → E-Mail festgelegt (Kontaktformular, Website-Analyse, Chatbot,
# Nachfass-Erinnerungen, Wochenbericht). Solange dort nichts steht, gehen neue
# Anfragen an diese Adresse(n) (mehrere mit Komma trennen):
CONTACT_TO_EMAIL=info@madex-it.ch

# --- KI: Chatbot «Orion» und Website-Analyse (OpenAI) -----------------------------------
# API-Schlüssel von https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modell für Chatbot und Analyse-Texte
OPENAI_MODEL=gpt-4o-mini

# --- Website-Analyse (Gratis-Analyse) -------------------------------------------------
# Empfohlen: Google PageSpeed Insights für Ladezeit, Core Web Vitals und Bildschirmfotos.
# Kostenloser Schlüssel: Google Cloud Console → «PageSpeed Insights API» aktivieren →
# API-Schlüssel erstellen.
PAGESPEED_API_KEY=
# Kostenbremse: so viele Analysen pro Stunde / pro Tag für alle Besucher zusammen.
# Darüber läuft keine Analyse mehr (die Anfrage kommt trotzdem unter Anfragen an).
ANALYSE_HOURLY_LIMIT=12
ANALYSE_DAILY_LIMIT=40

# --- Google Analytics, Search Console, Tag Manager --------------------------------------
# Tracking auf der Website (Mess-ID «G-…»; erst nach Einwilligung im Cookie-Banner)
NEXT_PUBLIC_GA4_ID=
# Optional: Google Tag Manager statt direktem GA4-Code
NEXT_PUBLIC_GTM_ID=

# Besucher, Sitzungen und Seitenaufrufe im Dashboard (Übersicht, Statistiken, Wochenbericht):
#  1. Google Cloud Console: Dienstkonto erstellen, JSON-Schlüssel herunterladen,
#     «Google Analytics Data API» und «Google Search Console API» aktivieren.
#  2. Google Analytics → Verwaltung → Zugriffsverwaltung für Properties:
#     E-Mail des Dienstkontos als «Betrachter» hinzufügen.
#  3. Search Console → Einstellungen → Nutzer und Berechtigungen:
#     dieselbe E-Mail hinzufügen («Eingeschränkt» genügt) – für Klicks und Position in SEO.
# Property-ID: nur die Ziffern (Verwaltung → Property-Einstellungen), nicht die Mess-ID.
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# «private_key» aus der JSON-Datei, in Anführungszeichen, Zeilenumbrüche als \n, z. B.
# "-----BEGIN PRIVATE KEY-----\nMIIE…\n-----END PRIVATE KEY-----\n"
# (Alternativ den ganzen Inhalt der JSON-Datei – dann kann die E-Mail oben leer bleiben.)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional: Search-Console-Property, falls nicht die Domain-Property sc-domain:madex-it.ch,
# z. B. https://madex-it.ch/
GSC_SITE_URL=

# --- Google Ads (Conversion-Tracking) ------------------------------------------------
# Läuft erst nach Zustimmung im Cookie-Banner. Jede Anfrage (Kontaktformular, Gratis-Analyse)
# zählt als Conversion – mit der Anfrage-Referenz als Transaktions-ID (keine Doppelzählung).
# Google-Tag-ID: Google Ads → Tools → Datenmanager → Google-Tag (Format AW-123456789)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion-Label: Google Ads → Ziele → Conversions → Ihre Conversion «Lead» → Tag einrichten →
# «Selbst installieren»: der Teil nach dem Schrägstrich in send_to: 'AW-123456789/AbCdEf…'
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# --- Meta Pixel & Conversions API (Facebook / Instagram) -----------------------------
# Läuft erst nach Zustimmung im Cookie-Banner. Seitenaufrufe und Anfragen (Kontaktformular,
# Gratis-Analyse, Chat-Terminanfragen) gehen als «Lead» an Meta – aus dem Browser und vom
# Server mit derselben Ereignis-ID, damit Meta jede Anfrage nur einmal zählt.
# Pixel-ID (Datensatz-ID): Meta Events Manager → Datenquellen → Ihr Pixel (nur Ziffern)
NEXT_PUBLIC_META_PIXEL_ID=
# Zugriffsschlüssel: Events Manager → Ihr Pixel → Einstellungen → Conversions API →
# «Zugriffsschlüssel generieren». Bleibt auf dem Server.
META_CONVERSIONS_API_TOKEN=
# Optional, nur beim Einrichten: Code aus Events Manager → «Test-Events» (danach wieder leeren)
META_TEST_EVENT_CODE=

# --- Google-Bewertungen (Startseite, Über uns, Partner) --------------------------------
# Zeigt die 4- und 5-Sterne-Bewertungen des Unternehmensprofils live an (max. 5 neueste,
# Cache 6 Stunden). Ohne Werte erscheinen die hinterlegten Kundenstimmen.
# Schlüssel: Google Cloud Console → «Places API (New)» aktivieren → API-Schlüssel erstellen
# und auf diese API beschränken.
GOOGLE_PLACES_API_KEY=
# Place ID des Profils (z. B. mit dem «Place ID Finder» von Google)
GOOGLE_PLACE_ID=

# --- Server -------------------------------------------------------------------------
# Hinter Coolify/Traefik true lassen (echte Besucher-IP aus X-Forwarded-For)
TRUST_PROXY=true

# --- Fortgeschritten (normalerweise leer lassen) ---------------------------------------
# Eigener Ordner für die eingebaute Datenbank bzw. die Uploads (Standard: in DATA_DIR)
PGLITE_DIR=
UPLOADS_DIR=
# Verbindungen zum externen PostgreSQL-Server (nur mit DATABASE_URL, Standard 10)
DATABASE_POOL=
# Cookies nur über HTTPS: Standard = automatisch in Produktion; false nur zum Testen ohne HTTPS
COOKIE_SECURE=
# true = Datenbank-Migrationen beim Start überspringen (nur bei manuellen Migrationen)
SKIP_MIGRATIONS=
# Zusätzlicher Schlüssel für die anonymisierten Besucher-IPs im Chat-Schutz (beliebiger Text)
ADMIN_SESSION_SECRET=
