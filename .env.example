# =============================================================================
# Madex IT Solutions – Umgebungsvariablen
# Kopieren Sie diese Datei nach .env (lokal) bzw. tragen Sie die Werte in Coolify
# unter "Environment Variables" ein. Werte ohne NEXT_PUBLIC_ bleiben auf dem Server.
# =============================================================================

# --- Website ------------------------------------------------------------------
# Öffentliche Basis-URL (Canonicals, Sitemap, Open Graph, Links in E-Mails)
NEXT_PUBLIC_SITE_URL=https://madex-it.ch

# --- Daten & Dashboard (/admin) -------------------------------------------------
# Ordner für ALLE Daten: eingebaute Datenbank (pglite/), Uploads, Schlüssel (.app-secret),
# Chat-Verläufe. Muss Neuinstallationen überstehen (Coolify: persistentes Volume, z. B. /app/data;
# Hostinger: ein Ordner ausserhalb des App-Ordners).
DATA_DIR=./.data
# Verschlüsselung der Chat-Ablage (AES-256). Einmal erzeugen und nie ändern: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Datenbank: LEER LASSEN = eingebaute Datenbank in DATA_DIR/pglite (kein Datenbank-Server nötig,
# die App darf dann nur einmal laufen). Nur für einen externen PostgreSQL-Server ausfüllen
# (Coolify-Datenbank, Neon, Supabase), z. B. postgres://user:pass@host:5432/db
DATABASE_URL=
# Optional: mind. 32 Zeichen. Leer = wird automatisch erzeugt und in DATA_DIR/.app-secret gespeichert.
APP_SECRET=
# Öffentliche Adresse (Links in E-Mails, Rückkehr von Zahlungsanbietern)
APP_URL=https://madex-it.ch
# Schutz für /api/cron (Wartung, z. B. stündlich aufrufen)
CRON_SECRET=

# --- Erster Admin-Zugang (/admin) ----------------------------------------------
# Inhaber-Konto bei leerer Datenbank automatisch anlegen (sonst Ersteinrichtung unter /admin).
# Anmeldung mit der E-MAIL-ADRESSE; beim ersten Login wird die Zwei-Faktor-Anmeldung eingerichtet.
# Passwort mind. 12 Zeichen.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Notfall: auf true setzen und App neu starten = Konto ADMIN_EMAIL bekommt ADMIN_PASSWORD,
# Sperre und 2FA werden zurückgesetzt. Danach WIEDER ENTFERNEN.
ADMIN_RESET=
# Probleme? Die Seite /admin/status zeigt ohne Anmeldung, was fehlt.

# --- E-Mail-Versand (SMTP) ------------------------------------------------------
# Für Kontaktformular, Analyse-Anfragen und Terminanfragen aus dem Chat
SMTP_HOST=
SMTP_PORT=587
# true für Port 465 (SSL), false für 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Absender (muss vom SMTP-Server erlaubt sein)
MAIL_FROM=Madex IT Solutions <website@madex-it.ch>
CONTACT_FROM_EMAIL=website@madex-it.ch
# Empfänger der Anfragen (mehrere mit Komma trennen)
CONTACT_TO_EMAIL=info@madex-it.ch

# --- KI-Chatbot «Orion» (OpenAI) ---------------------------------------------------
# API-Schlüssel von https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modell für Chatbot und Website-Analyse
OPENAI_MODEL=gpt-4o-mini

# --- Website-Analyse (Gratis-Analyse im Hero) --------------------------------------
# Die Texte des Berichts schreibt dieselbe KI wie der Chatbot (OPENAI_API_KEY, Modell aus dem Admin).
# Optional, aber empfohlen: Google PageSpeed Insights für Ladezeit, Core Web Vitals und Bildschirmfotos.
# Kostenloser Schlüssel: Google Cloud Console -> "PageSpeed Insights API" aktivieren -> API-Schlüssel erstellen.
PAGESPEED_API_KEY=
# Kostenbremse: so viele Analysen pro Stunde / pro Tag für alle Besucher zusammen.
# Darüber hinaus läuft keine Analyse mehr (die Anfrage kommt trotzdem unter Anfragen an).
ANALYSE_HOURLY_LIMIT=12
ANALYSE_DAILY_LIMIT=40

# --- Google Analytics & Tag Manager --------------------------------------------
# Mess-ID für das Tracking auf der Website (G-…)
NEXT_PUBLIC_GA4_ID=
# Optional: Google Tag Manager statt direktem GA4-Code
NEXT_PUBLIC_GTM_ID=
# Besucherzahlen im Dashboard (Google Analytics Data API, Dienstkonto als "Betrachter").
# Dasselbe Dienstkonto liefert Klicks und Position aus der Google Search Console (dort als Nutzer hinzufügen).
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Privater Schlüssel aus der JSON-Datei, Zeilenumbrüche als \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: Search-Console-Property, falls nicht die Domain-Property (z. B. sc-domain:madex-it.ch oder https://madex-it.ch/)
GSC_SITE_URL=

# --- Google-Bewertungen (Startseite, Über uns, Partner) ------------------------
# Zeigt die 4- und 5-Sterne-Bewertungen des Google-Unternehmensprofils live an
# (max. 5 neueste von Google, Cache 6 Stunden). Ohne Werte erscheinen die
# hinterlegten Kundenstimmen. Schlüssel: Google Cloud Console → "Places API (New)"
# aktivieren → API-Schlüssel erstellen und auf diese API beschränken.
GOOGLE_PLACES_API_KEY=
# Place ID des Profils (z. B. mit dem "Place ID Finder" von Google ermitteln)
GOOGLE_PLACE_ID=

# --- Server -------------------------------------------------------------------
# Hinter Coolify/Traefik true lassen (echte Besucher-IP aus X-Forwarded-For)
TRUST_PROXY=true
