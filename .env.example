# =============================================================================
# Madex IT Solutions – Umgebungsvariablen
# Kopieren Sie diese Datei nach .env (lokal) bzw. tragen Sie die Werte in Coolify
# unter "Environment Variables" ein. Werte ohne NEXT_PUBLIC_ bleiben auf dem Server.
# =============================================================================

# --- Website ------------------------------------------------------------------
# Öffentliche Basis-URL (Canonicals, Sitemap, Open Graph, Links in E-Mails)
NEXT_PUBLIC_SITE_URL=https://madex-it.ch

# --- Admin-Dashboard (/admin) -----------------------------------------------------
# Benutzername und Passwort (mind. 10 Zeichen, besser 16+). Beim ersten Login wird
# die Zwei-Faktor-Anmeldung (Authenticator-App) eingerichtet.
ADMIN_USERNAME=madex
ADMIN_PASSWORD=
# Zufälliger Geheimwert, z. B.: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Automatische Abmeldung nach Inaktivität (Minuten)
ADMIN_IDLE_MINUTES=30
# Nur auf "false" setzen, wenn die Seite ohne HTTPS läuft (nicht empfohlen)
ADMIN_COOKIE_SECURE=true

# --- Datenablage --------------------------------------------------------------
# Ordner für Anfragen, Chats und Einstellungen. In Coolify als persistentes
# Volume einbinden (z. B. /app/data), sonst gehen die Daten bei jedem Deploy verloren.
DATA_DIR=./.data
# Verschlüsselung der gespeicherten Daten (AES-256). Einmal erzeugen und nie ändern:
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# --- E-Mail-Versand (SMTP) ------------------------------------------------------
# Für Kontaktformular, Analyse-Anfragen und Terminanfragen aus dem Chat
SMTP_HOST=
SMTP_PORT=587
# true für Port 465 (SSL), false für 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Absender (muss vom SMTP-Server erlaubt sein)
MAIL_FROM=Madex IT Solutions <website@madex-it.ch>
CONTACT_FROM_EMAIL=website@madex-it.ch
# Empfänger der Anfragen (mehrere mit Komma trennen)
CONTACT_TO_EMAIL=info@madex-it.ch

# --- KI-Chatbot «Orion» (OpenAI) ---------------------------------------------------
# API-Schlüssel von https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modell (im Admin unter "Chatbot & Wissen" änderbar)
OPENAI_MODEL=gpt-4o-mini

# --- Google Analytics & Tag Manager --------------------------------------------
# Mess-ID für das Tracking (kann auch im Admin eingetragen werden)
NEXT_PUBLIC_GA4_ID=
# Optional: Google Tag Manager statt direktem GA4-Code
NEXT_PUBLIC_GTM_ID=
# Berichte im Admin (Google Analytics Data API, Dienstkonto als "Betrachter")
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Privater Schlüssel aus der JSON-Datei, Zeilenumbrüche als \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google-Bewertungen (Startseite, Über uns, Partner) ------------------------
# Zeigt die 4- und 5-Sterne-Bewertungen des Google-Unternehmensprofils live an
# (max. 5 neueste von Google, Cache 6 Stunden). Ohne Werte erscheinen die
# hinterlegten Kundenstimmen. Schlüssel: Google Cloud Console → "Places API (New)"
# aktivieren → API-Schlüssel erstellen und auf diese API beschränken.
GOOGLE_PLACES_API_KEY=
# Place ID des Profils (z. B. mit dem "Place ID Finder" von Google ermitteln)
GOOGLE_PLACE_ID=

# --- Server -------------------------------------------------------------------
# Hinter Coolify/Traefik true lassen (echte Besucher-IP aus X-Forwarded-For)
TRUST_PROXY=true
