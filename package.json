{
  "name": "madex-newweb",
  "version": "1.0.0",
  "private": true,
  "description": "Madex IT Solutions – neuer interaktiver 3D-Webauftritt (Next.js, React Three Fiber)",
  "scripts": {
    "dev": "tsx scripts/db-push.ts && next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content": "python3 -I scripts/extract_content.py && python3 -I scripts/prepare_media.py",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx scripts/db-push.ts",
    "db:reset": "tsx scripts/db-reset.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "drizzle-orm": "0.45.4",
    "framer-motion": "^12.43.0",
    "lenis": "^1.3.11",
    "next": "^16.4.1",
    "nodemailer": "^10.1.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "23.0.0",
    "three": "^0.180.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
